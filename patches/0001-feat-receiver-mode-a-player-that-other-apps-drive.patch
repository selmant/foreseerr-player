--- /dev/null
+++ b/lib/receiver/receiver_mode.dart
@@ -0,0 +1,108 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:get_it/get_it.dart';
+import 'package:window_manager/window_manager.dart';
+
+import '../auth/repositories/session_repository.dart';
+import '../ui/navigation/app_router.dart' show PlayerRouteObserver;
+import '../ui/navigation/destinations.dart';
+import '../util/app_exit.dart';
+import '../util/fullscreen_helper.dart';
+import '../util/platform_detection.dart';
+
+/// Receiver mode turns the app into a player that other apps drive: a
+/// Jellyfin remote `PlayNow` or a play link opens the player, and nothing
+/// but the player is shown. Between plays the window is hidden on desktop.
+///
+/// Built in with `--dart-define=RECEIVER_MODE=true`.
+const bool receiverModeEnabled = bool.fromEnvironment('RECEIVER_MODE');
+
+/// Routes receiver mode still allows: signing in, its own idle page and the
+/// players. Everything else lands on the idle page.
+bool receiverAllowsPath(String path) =>
+    path == Destinations.receiver || Destinations.isPlayerRoute(path);
+
+/// What a play link (`/item/<id>?autoPlay=true`, from `moonfin://play`)
+/// starts, or null for any other route.
+({String itemId, int? startTicks})? receiverPlayTarget(String route) {
+  final uri = Uri.tryParse(route);
+  if (uri == null || uri.queryParameters['autoPlay'] != 'true') return null;
+  final segments = uri.pathSegments;
+  if (segments.length != 2 || segments.first != 'item') return null;
+  final id = segments[1];
+  if (id.isEmpty) return null;
+  return (
+    itemId: id,
+    startTicks: int.tryParse(uri.queryParameters['startTicks'] ?? ''),
+  );
+}
+
+/// Starts a play link's item the way a remote `PlayNow` does.
+Future<void> receiverPlay(({String itemId, int? startTicks}) target) =>
+    GetIt.instance<SessionRepository>().playNow(
+      [target.itemId],
+      startPositionTicks: target.startTicks,
+    );
+
+/// Shows the window while a player is open and hides it once none is.
+class ReceiverWindowController {
+  ReceiverWindowController._();
+
+  static final instance = ReceiverWindowController._();
+
+  bool _started = false;
+  bool _quitting = false;
+  Timer? _hideTimer;
+
+  /// Whether a window close should really quit, as opposed to hiding.
+  bool get quitting => _quitting;
+
+  void start() {
+    if (!receiverModeEnabled || !PlatformDetection.isDesktop || _started) {
+      return;
+    }
+    _started = true;
+    PlayerRouteObserver.instance.isPlayerActive.addListener(_onPlayerChanged);
+  }
+
+  void _onPlayerChanged() {
+    _hideTimer?.cancel();
+    if (PlayerRouteObserver.instance.isPlayerActive.value) {
+      unawaited(_present());
+      return;
+    }
+    // One player replacing another (next episode, next up) passes through
+    // "no player" for a moment, so only hide once that has settled.
+    _hideTimer = Timer(const Duration(milliseconds: 800), () {
+      if (!PlayerRouteObserver.instance.isPlayerActive.value) {
+        unawaited(hide());
+      }
+    });
+  }
+
+  Future<void> _present() async {
+    try {
+      await windowManager.show();
+      await windowManager.focus();
+      await FullscreenHelper.setFullscreen(true);
+    } catch (e) {
+      debugPrint('[Receiver] present failed: $e');
+    }
+  }
+
+  Future<void> hide() async {
+    try {
+      await FullscreenHelper.setFullscreen(false);
+      await windowManager.hide();
+    } catch (e) {
+      debugPrint('[Receiver] hide failed: $e');
+    }
+  }
+
+  /// Quits for real, where a window close only hides.
+  Future<void> quit() async {
+    _quitting = true;
+    await AppExit.closeApp();
+  }
+}
