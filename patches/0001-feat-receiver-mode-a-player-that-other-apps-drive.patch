+/// Receiver mode's idle page. Normally hidden: it shows only when the app
+/// is opened by hand, to tell who is signed in and offer hiding or quitting.
+class ReceiverScreen extends StatelessWidget {
+  const ReceiverScreen({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final user = GetIt.instance<UserRepository>().currentUser;
+    final server = user == null
+        ? null
+        : GetIt.instance<ServerRepository>().getServer(user.serverId);
+    final theme = Theme.of(context);
+    return Scaffold(
+      backgroundColor: Colors.black,
+      body: Center(
+        child: Padding(
+          padding: const EdgeInsets.all(24),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Icon(
+                Icons.play_circle_outline,
+                size: 72,
+                color: theme.colorScheme.primary,
+              ),
+              const SizedBox(height: 16),
+              Text(
+                'Ready to play',
+                style: theme.textTheme.headlineSmall?.copyWith(
+                  color: Colors.white,
+                ),
+              ),
+              const SizedBox(height: 8),
+              Text(
+                user == null
+                    ? 'Not signed in'
+                    : 'Signed in as ${user.name}'
+                          '${server == null ? '' : ' on ${server.name}'}',
+                style: theme.textTheme.bodyMedium?.copyWith(
+                  color: Colors.white70,
+                ),
+                textAlign: TextAlign.center,
+              ),
+              const SizedBox(height: 4),
+              Text(
+                'Start playback from Foreseerr. This window hides between plays.',
+                style: theme.textTheme.bodySmall?.copyWith(
+                  color: Colors.white54,
+                ),
+                textAlign: TextAlign.center,
+              ),
+              const SizedBox(height: 24),
+              Wrap(
+                spacing: 12,
+                children: [
+                  FilledButton(
+                    autofocus: true,
+                    onPressed: ReceiverWindowController.instance.hide,
+                    child: const Text('Hide'),
+                  ),
+                  OutlinedButton(
+                    onPressed: ReceiverWindowController.instance.quit,
+                    child: const Text('Quit'),
+                  ),
+                ],
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
