From 1142f19c5f5f738fcc210b4fb7b3eeedea49fed9 Mon Sep 17 00:00:00 2001
From: Selman Trabzon <selman.trbzon@gmail.com>
Date: Sat, 21 Nov 2026 16:20:00 +0300
Subject: [PATCH 9/9] feat: sign in with foreseerr's jellyfin session

Redeem the pairing ticket for the user's linked Jellyfin session and sign
in with its token, as Moonfin's web client does with Jellyfin web's,
instead of Quick Connect.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/receiver/receiver_pairing.dart | 78 ++++++++++++++++++++----------
 1 file changed, 52 insertions(+), 26 deletions(-)

diff --git a/lib/receiver/receiver_pairing.dart b/lib/receiver/receiver_pairing.dart
index 135b902ff..cc95112e5 100644
--- a/lib/receiver/receiver_pairing.dart
+++ b/lib/receiver/receiver_pairing.dart
@@ -5,11 +5,12 @@ import 'package:flutter/foundation.dart';
 import 'package:get_it/get_it.dart';
 import 'package:window_manager/window_manager.dart';
 
-import '../auth/models/login_state.dart';
 import '../auth/models/server.dart';
-import '../auth/repositories/auth_repository.dart';
+import '../auth/models/user.dart';
 import '../auth/repositories/server_repository.dart';
 import '../auth/repositories/session_repository.dart';
+import '../auth/store/authentication_preferences.dart';
+import '../auth/store/authentication_store.dart';
 import '../data/services/media_server_client_factory.dart';
 import '../ui/navigation/app_router.dart' show appRouter;
 import '../ui/navigation/destinations.dart';
@@ -23,9 +24,10 @@ import 'receiver_mode.dart';
 ///
 /// Foreseerr sends a fresh single-use ticket with every play. The player
 /// asks Foreseerr which Jellyfin server and user it is for, switches to that
-/// user when it is already signed in, and otherwise signs in with Quick
-/// Connect, Foreseerr approving the code as the ticket's user. Then it plays
-/// `id`. A ticket it didn't need just expires.
+/// user when it is already signed in, and otherwise redeems the ticket for
+/// the Jellyfin session Foreseerr holds for that user and signs in with it,
+/// as Moonfin's web client does with Jellyfin web's. Then it plays `id`. A
+/// ticket it didn't need just expires.
 class ReceiverPairing {
   ReceiverPairing._();
 
@@ -129,35 +131,59 @@ class ReceiverPairing {
     }
 
     status.value = 'Signing in through Foreseerr…';
+    final redeemed = (await api.post<Map<String, dynamic>>(
+      '/redeem',
+      data: {'ticket': ticket},
+    )).data!;
+    await _signInWithToken(
+      server,
+      userId: redeemed['userId'] as String,
+      token: redeemed['accessToken'] as String,
+    );
+    appRouter.go(Destinations.receiver);
+  }
+
+  /// Signs in with an access token Foreseerr handed over: checks it, stores
+  /// the user and makes it the active session.
+  static Future<void> _signInWithToken(
+    Server server, {
+    required String userId,
+    required String token,
+  }) async {
     final client = GetIt.instance<MediaServerClientFactory>().getClient(
       serverId: server.id,
       serverType: server.serverType,
       baseUrl: server.address,
     );
-    final qc = await client.authApi.initiateQuickConnect();
-    final code = qc['Code'] as String?;
-    final secret = qc['Secret'] as String?;
-    if (code == null || secret == null) {
-      throw StateError('Jellyfin did not start Quick Connect');
+    client.accessToken = token;
+    client.userId = userId;
+    final me = await client.usersApi.getCurrentUser();
+    if (me.id != userId) {
+      throw StateError('The token from Foreseerr is for another user');
     }
-    await api.post<Object?>(
-      '/quickconnect',
-      data: {'ticket': ticket, 'code': code},
+    final user = PrivateUser(
+      id: me.id,
+      name: (me.name ?? '').trim().isNotEmpty ? me.name!.trim() : 'Foreseerr',
+      serverId: server.id,
+      accessToken: token,
+      lastUsed: DateTime.now(),
+      imageTag: me.primaryImageTag,
+      isAdministrator: me.policy?.isAdministrator ?? false,
+      canDownload: me.policy?.enableContentDownloading ?? false,
+      canManageSubtitles: me.policy?.canFetchRemoteSubtitles ?? false,
+      canManageCollections: me.policy?.enableCollectionManagement ?? false,
+      canManageLiveTv: me.policy?.enableLiveTvManagement ?? false,
     );
-    final state = await GetIt.instance<AuthRepository>()
-        .authenticateWithQuickConnect(
-          client: client,
-          serverId: server.id,
-          secret: secret,
-        );
-    if (state is! Authenticated) {
-      throw StateError('Jellyfin refused the sign in ($state)');
+    await GetIt.instance<AuthenticationStore>().putUser(user);
+    final prefs = GetIt.instance<AuthenticationPreferences>();
+    await prefs.setLastServerId(server.id);
+    await prefs.setLastUserId(user.id);
+    if (!await GetIt.instance<SessionRepository>().switchCurrentSession(
+      serverId: server.id,
+      userId: user.id,
+    )) {
+      throw StateError('Could not switch to the signed-in user');
     }
-    await session.switchCurrentSession(
-      serverId: state.serverId,
-      userId: state.userId,
-    );
-    appRouter.go(Destinations.receiver);
   }
 
   /// The stored server at one of [urls], added when there is none yet.
