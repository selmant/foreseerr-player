From 15d6f576ab823a0453383496b9e525c4d5fdd881 Mon Sep 17 00:00:00 2001
From: Selman Trabzon <selman.trbzon@gmail.com>
Date: Fri, 20 Nov 2026 23:05:53 +0300
Subject: [PATCH 3/9] chore: rebrand the linux build as foreseerr player

Own app ID, binary name, window title, MPRIS name and
foreseerr-player:// scheme, so the build keeps its data, keyring entry
and desktop entry apart from an installed Moonfin.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/playback/mpris_service.dart | 4 ++--
 lib/receiver/receiver_mode.dart | 2 +-
 linux/CMakeLists.txt            | 4 ++--
 linux/runner/my_application.cc  | 8 ++++----
 4 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/lib/playback/mpris_service.dart b/lib/playback/mpris_service.dart
index 06b5a1d84..a57d8a179 100644
--- a/lib/playback/mpris_service.dart
+++ b/lib/playback/mpris_service.dart
@@ -14,7 +14,7 @@ import 'car_artwork.dart';
 
 // Flatpak grants the MPRIS name built from the app ID without a permission.
 final _busName =
-    'org.mpris.MediaPlayer2.${PlatformDetection.flatpakAppId ?? 'moonfin'}';
+    'org.mpris.MediaPlayer2.${PlatformDetection.flatpakAppId ?? 'foreseerr_player'}';
 const _objectPath = '/org/mpris/MediaPlayer2';
 const _rootInterface = 'org.mpris.MediaPlayer2';
 const _playerInterface = 'org.mpris.MediaPlayer2.Player';
@@ -374,7 +374,7 @@ class _MprisPlayer extends DBusObject {
       case 'HasTrackList':
         return const DBusBoolean(false);
       case 'Identity':
-        return const DBusString('Moonfin');
+        return const DBusString('Foreseerr Player');
       case 'DesktopEntry':
         // Flatpak names the desktop entry after the ID it was installed under.
         return DBusString(
diff --git a/lib/receiver/receiver_mode.dart b/lib/receiver/receiver_mode.dart
index 26635964a..d367d2e78 100644
--- a/lib/receiver/receiver_mode.dart
+++ b/lib/receiver/receiver_mode.dart
@@ -19,7 +19,7 @@ import '../util/platform_detection.dart';
 const bool receiverModeEnabled = bool.fromEnvironment('RECEIVER_MODE');
 
 /// The URL scheme the app answers to.
-const String appLinkScheme = 'moonfin';
+const String appLinkScheme = 'foreseerr-player';
 
 /// Routes receiver mode still allows: signing in, its own idle page and the
 /// players. Everything else lands on the idle page.
diff --git a/linux/CMakeLists.txt b/linux/CMakeLists.txt
index c7a3dd6c6..8a6f10c18 100644
--- a/linux/CMakeLists.txt
+++ b/linux/CMakeLists.txt
@@ -2,8 +2,8 @@
 cmake_minimum_required(VERSION 3.13)
 project(runner LANGUAGES CXX)
 
-set(BINARY_NAME "moonfin")
-set(APPLICATION_ID "org.moonfin.linux")
+set(BINARY_NAME "foreseerr-player")
+set(APPLICATION_ID "org.foreseerr.player")
 
 # Explicitly opt in to modern CMake behaviors to avoid warnings with recent
 # versions of CMake.
diff --git a/linux/runner/my_application.cc b/linux/runner/my_application.cc
index 8260aea07..b1305abf3 100644
--- a/linux/runner/my_application.cc
+++ b/linux/runner/my_application.cc
@@ -51,8 +51,8 @@ static void my_application_set_window_icon(GtkWindow* window) {
 #define MOONFIN_ENTRY_SIGNATURE            \
   "[Desktop Entry]\n"                      \
   "Type=Application\n"                     \
-  "Name=Moonfin\n"                         \
-  "Comment=Jellyfin & Emby media client\n" \
+  "Name=Foreseerr Player\n"                \
+  "Comment=Player for Foreseerr\n"         \
   "Exec=\""
 
 static gboolean my_application_is_own_entry(const gchar* contents) {
@@ -261,7 +261,7 @@ static void my_application_install_desktop_entry() {
       "Categories=AudioVideo;Video;\n"
       "Terminal=false\n"
       "StartupWMClass=%s\n"
-      "MimeType=x-scheme-handler/moonfin;\n",
+      "MimeType=x-scheme-handler/foreseerr-player;\n",
       appimage, APPLICATION_ID, APPLICATION_ID);
 
   // Rewrite only when something changed, so moving the image updates the entry
@@ -305,7 +305,7 @@ static void my_application_activate(GApplication* application) {
   GtkWindow* window =
       GTK_WINDOW(gtk_application_window_new(GTK_APPLICATION(application)));
 
-  gtk_window_set_title(window, "Moonfin");
+  gtk_window_set_title(window, "Foreseerr Player");
   my_application_install_desktop_entry();
   my_application_set_window_icon(window);
 
-- 
2.56.0

