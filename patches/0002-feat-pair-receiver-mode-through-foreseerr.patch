diff --git a/lib/receiver/receiver_pairing.dart b/lib/receiver/receiver_pairing.dart
new file mode 100644
index 000000000..4e054f5cb
--- /dev/null
+++ b/lib/receiver/receiver_pairing.dart
@@ -0,0 +1,150 @@
+import 'dart:async';
+
+import 'package:dio/dio.dart';
+import 'package:flutter/foundation.dart';
+import 'package:get_it/get_it.dart';
+import 'package:window_manager/window_manager.dart';
+
+import '../auth/models/login_state.dart';
+import '../auth/models/server.dart';
+import '../auth/repositories/auth_repository.dart';
+import '../auth/repositories/server_repository.dart';
+import '../auth/repositories/session_repository.dart';
+import '../data/services/media_server_client_factory.dart';
+import '../ui/navigation/app_router.dart' show appRouter;
+import '../ui/navigation/destinations.dart';
+import '../util/platform_detection.dart';
+import 'receiver_mode.dart';
+
+/// Signs the player in for a Foreseerr user, from a pair link:
+///
+/// `<scheme>://pair?foreseerr=<url>&ticket=<ticket>`
+/// `[&id=<itemId>[&startTicks=<ticks>]]`
+///
+/// The player starts Jellyfin Quick Connect and Foreseerr approves the code
+/// as the ticket's user, so the player gets a Jellyfin device and session of
+/// its own. The ticket is single use and short lived. An `id` starts that
+/// item once signed in.
+class ReceiverPairing {
+  ReceiverPairing._();
+
+  static final instance = ReceiverPairing._();
+
+  /// What the idle page shows while pairing, or why it failed.
+  final ValueNotifier<String?> status = ValueNotifier<String?>(null);
+
+  bool _busy = false;
+
+  static bool isPairLink(Uri uri) => uri.host == 'pair';
+
+  Future<void> handle(Uri uri) async {
+    final query = uri.queryParameters;
+    final foreseerr = Uri.tryParse(query['foreseerr'] ?? '');
+    final ticket = query['ticket'];
+    if (foreseerr == null ||
+        !(foreseerr.isScheme('http') || foreseerr.isScheme('https')) ||
+        foreseerr.host.isEmpty ||
+        ticket == null ||
+        ticket.isEmpty) {
+      status.value = 'This pairing link is incomplete.';
+      return;
+    }
+    if (_busy) return;
+    _busy = true;
+    status.value = 'Signing in through Foreseerr…';
+    try {
+      await _pair(foreseerr, ticket);
+      status.value = null;
+      final id = query['id'];
+      if (id != null && id.isNotEmpty) {
+        await receiverPlay((
+          itemId: id,
+          startTicks: int.tryParse(query['startTicks'] ?? ''),
+        ));
+      }
+    } catch (e, st) {
+      debugPrint('[Receiver] pairing failed: $e\n$st');
+      status.value = 'Could not sign in: ${_describe(e)}';
+      if (PlatformDetection.isDesktop) {
+        try {
+          await windowManager.show();
+        } catch (_) {}
+      }
+    } finally {
+      _busy = false;
+    }
+  }
+
+  Future<void> _pair(Uri foreseerr, String ticket) async {
+    final base = foreseerr.toString().replaceFirst(RegExp(r'/+$'), '');
+    final api = Dio(
+      BaseOptions(
+        baseUrl: '$base/api/v1/player/pair-tickets',
+        connectTimeout: const Duration(seconds: 10),
+        receiveTimeout: const Duration(seconds: 20),
+        contentType: Headers.jsonContentType,
+      ),
+    );
+    final info = (await api.post<Map<String, dynamic>>(
+      '/info',
+      data: {'ticket': ticket},
+    )).data!;
+    final urls = (info['serverUrls'] as List).cast<String>();
+
+    final servers = GetIt.instance<ServerRepository>();
+    await servers.loadStoredServers();
+    Server? server;
+    for (final url in urls) {
+      try {
+        server = await servers.addServer(url);
+      } catch (e) {
+        debugPrint('[Receiver] $url unreachable: $e');
+      }
+      if (server != null) break;
+    }
+    if (server == null) {
+      throw StateError('Jellyfin is unreachable at ${urls.join(', ')}');
+    }
+
+    final client = GetIt.instance<MediaServerClientFactory>().getClient(
+      serverId: server.id,
+      serverType: server.serverType,
+      baseUrl: server.address,
+    );
+    final qc = await client.authApi.initiateQuickConnect();
+    final code = qc['Code'] as String?;
+    final secret = qc['Secret'] as String?;
+    if (code == null || secret == null) {
+      throw StateError('Jellyfin did not start Quick Connect');
+    }
+    await api.post<Object?>(
+      '/quickconnect',
+      data: {'ticket': ticket, 'code': code},
+    );
+    final state = await GetIt.instance<AuthRepository>()
+        .authenticateWithQuickConnect(
+          client: client,
+          serverId: server.id,
+          secret: secret,
+        );
+    if (state is! Authenticated) {
+      throw StateError('Jellyfin refused the sign in ($state)');
+    }
+    await GetIt.instance<SessionRepository>().switchCurrentSession(
+      serverId: state.serverId,
+      userId: state.userId,
+    );
+    appRouter.go(Destinations.receiver);
+  }
+
+  static String _describe(Object e) {
+    if (e is DioException) {
+      final data = e.response?.data;
+      final code = data is Map ? data['code'] : null;
+      if (code != null) return '$code';
+      return e.message ?? e.type.name;
+    }
+    if (e is StateError) return e.message;
+    return '$e';
+  }
+}
