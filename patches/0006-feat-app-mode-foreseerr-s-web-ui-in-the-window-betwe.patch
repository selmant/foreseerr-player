+    final web = ForeseerrWeb.instance;
+    final pairing = ReceiverPairing.instance;
+    return Scaffold(
+      backgroundColor: Colors.black,
+      body: ListenableBuilder(
+        listenable: Listenable.merge([
+          web.url,
+          web.error,
+          pairing.status,
+          pairing.busy,
+        ]),
+        builder: (context, _) {
+          final status = pairing.status.value;
+          if (status != null) {
