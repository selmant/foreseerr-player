diff --git a/lib/receiver/foreseerr_web.dart b/lib/receiver/foreseerr_web.dart
new file mode 100644
index 000000000..04a6b7fe6
--- /dev/null
+++ b/lib/receiver/foreseerr_web.dart
@@ -0,0 +1,170 @@
+import 'dart:async';
+import 'dart:io' show Platform;
+
+import 'package:dio/dio.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../ui/navigation/app_router.dart' show PlayerRouteObserver;
+import 'receiver_mode.dart';
+import 'receiver_pairing.dart';
+
+/// App mode: the window is Foreseerr. Foreseerr's own web UI, loaded from
+/// its server, fills the window between plays, and the player takes over
+/// while something plays. Play buttons in the page hand their open link to
+/// the player directly (see `linux/runner/foreseerr_web.cc`).
+///
+/// Linux only for now; elsewhere receiver mode stays a hidden player.
+class ForeseerrWeb {
+  ForeseerrWeb._();
+
+  static final instance = ForeseerrWeb._();
+
+  static const _channel = MethodChannel('foreseerr/web');
+  static const _urlKey = 'foreseerr.url';
+
+  static bool get supported =>
+      receiverModeEnabled && !kIsWeb && Platform.isLinux;
+
+  /// The Foreseerr address, or null before setup.
+  final ValueNotifier<String?> url = ValueNotifier<String?>(null);
+
+  /// Why the page could not be loaded.
+  final ValueNotifier<String?> error = ValueNotifier<String?>(null);
+
+  bool _started = false;
+  bool _shown = false;
+  bool _playing = false;
+  Timer? _playTimeout;
+
+  Future<void> start() async {
+    if (!supported || _started) return;
+    _started = true;
+    _channel.setMethodCallHandler(_onCall);
+    ReceiverPairing.instance.status.addListener(_sync);
+    PlayerRouteObserver.instance.isPlayerActive.addListener(_sync);
+    final saved = (await SharedPreferences.getInstance()).getString(_urlKey);
+    if (saved != null) await _load(saved);
+  }
+
+  /// Checks that [address] is a Foreseerr server, then saves and opens it.
+  /// Returns why not, or null.
+  Future<String?> connect(String address) async {
+    var text = address.trim().replaceFirst(RegExp(r'/+$'), '');
+    if (!text.contains('://')) text = 'https://$text';
+    final uri = Uri.tryParse(text);
+    if (uri == null ||
+        !(uri.isScheme('http') || uri.isScheme('https')) ||
+        uri.host.isEmpty) {
+      return 'That is not a web address.';
+    }
+    try {
+      final status = await Dio(
+        BaseOptions(
+          connectTimeout: const Duration(seconds: 10),
+          receiveTimeout: const Duration(seconds: 10),
+        ),
+      ).get<Object?>('$text/api/v1/status');
+      final data = status.data;
+      if (data is! Map || data['version'] == null) {
+        return 'No Foreseerr at $text.';
+      }
+    } on DioException catch (e) {
+      return 'Could not reach $text: ${e.message ?? e.type.name}';
+    }
+    await (await SharedPreferences.getInstance()).setString(_urlKey, text);
+    await _load(text);
+    return null;
+  }
+
+  /// Back to setup, to use another address.
+  Future<void> forget() async {
+    await (await SharedPreferences.getInstance()).remove(_urlKey);
+    url.value = null;
+    error.value = null;
+    _sync();
+  }
+
+  Future<void> retry() async {
+    final current = url.value;
+    if (current != null) await _load(current);
+  }
+
+  Future<void> _load(String address) async {
+    url.value = address;
+    error.value = null;
+    try {
+      await _channel.invokeMethod<void>('load', {'url': address});
+    } on PlatformException catch (e) {
+      error.value = e.message ?? e.code;
+    }
+    _sync();
+  }
+
+  /// A play is starting: the player takes the window.
+  void playerRequested() {
+    _playing = true;
+    _playTimeout?.cancel();
+    // A play that never opens a player must not leave Foreseerr hidden.
+    _playTimeout = Timer(const Duration(seconds: 20), () {
+      if (!PlayerRouteObserver.instance.isPlayerActive.value) playerClosed();
+    });
+    _sync();
+  }
+
+  /// The player is gone for good: Foreseerr comes back.
+  void playerClosed() {
+    _playTimeout?.cancel();
+    _playing = false;
+    _sync();
+  }
+
+  void _sync() {
+    final show =
+        url.value != null &&
+        error.value == null &&
+        ReceiverPairing.instance.status.value == null &&
+        !_playing &&
+        !PlayerRouteObserver.instance.isPlayerActive.value;
+    if (show == _shown) return;
+    _shown = show;
+    _channel.invokeMethod<void>('show', show).catchError((Object e) {
+      debugPrint('[Foreseerr] show failed: $e');
+    });
+  }
+
+  Future<Object?> _onCall(MethodCall call) async {
+    switch (call.method) {
+      case 'open':
+        final link = Uri.tryParse(call.arguments as String? ?? '');
+        if (link != null && _isOwnLink(link)) {
+          unawaited(ReceiverPairing.instance.handle(link));
+        }
+      case 'loadFailed':
+        error.value = call.arguments as String? ?? 'unknown error';
+        _sync();
+    }
+    return null;
+  }
+
+  /// Only links for this Foreseerr: a page elsewhere can't point the
+  /// player at another server.
+  bool _isOwnLink(Uri link) {
+    if (!link.isScheme(appLinkScheme) || !ReceiverPairing.isOpenLink(link)) {
+      return false;
+    }
+    final home = _origin(url.value);
+    return home != null && home == _origin(link.queryParameters['foreseerr']);
+  }
+
+  static String? _origin(String? address) {
+    final uri = Uri.tryParse(address ?? '');
+    if (uri == null || uri.host.isEmpty) return null;
+    try {
+      return uri.origin.toLowerCase();
+    } on StateError {
+      return null;
+    }
+  }
+}
