+}
+
+class _AppModeScreenState extends State<_AppModeScreen> {
+  final _address = TextEditingController();
+  String? _setupError;
+  bool _connecting = false;
+
+  @override
+  void dispose() {
+    _address.dispose();
+    super.dispose();
+  }
+
+  Future<void> _connect() async {
+    if (_connecting) return;
+    setState(() {
+      _connecting = true;
+      _setupError = null;
+    });
+    final error = await ForeseerrWeb.instance.connect(_address.text);
+    if (!mounted) return;
+    setState(() {
+      _connecting = false;
+      _setupError = error;
+    });
+  }
