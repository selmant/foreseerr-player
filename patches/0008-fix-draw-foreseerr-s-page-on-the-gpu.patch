From 47ee1b4df490cf7fbbc33fe9d449ab3f5778c7a4 Mon Sep 17 00:00:00 2001
From: Selman Trabzon <selman.trbzon@gmail.com>
Date: Sat, 21 Nov 2026 14:49:24 +0300
Subject: [PATCH 8/8] fix: draw foreseerr's page on the gpu

WebKitGTK 2.54's Skia compositor flashes old frames during fades and
leaks on backdrop-filter; the previous one doesn't. On NVIDIA under
Wayland, explicit sync off avoids protocol error 71, instead of turning
the GPU renderer off (about 4 fps on 4K).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux/runner/foreseerr_web.cc | 18 ++++++++++++------
 linux/runner/foreseerr_web.h  |  3 +++
 linux/runner/main.cc          |  2 ++
 3 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/linux/runner/foreseerr_web.cc b/linux/runner/foreseerr_web.cc
index dbaa716c0..83d2a1f8c 100644
--- a/linux/runner/foreseerr_web.cc
+++ b/linux/runner/foreseerr_web.cc
@@ -243,12 +243,6 @@ gboolean OnButtonPress(GtkWidget*, GdkEventButton* event, gpointer) {
 // directory, so Foreseerr stays signed in across runs.
 void EnsureWebView() {
   if (web != nullptr) return;
-  // WebKitGTK's DMA-BUF renderer breaks on NVIDIA's driver under Wayland:
-  // its compositor thread spins and the web process grows by hundreds of
-  // MB a second (MiniBrowser dies outright). Shared-memory buffers work.
-  if (g_file_test("/sys/module/nvidia", G_FILE_TEST_IS_DIR)) {
-    g_setenv("WEBKIT_DISABLE_DMABUF_RENDERER", "1", FALSE);
-  }
   g_autofree gchar* data_dir =
       g_build_filename(g_get_user_data_dir(), APPLICATION_ID, "web", nullptr);
   g_autofree gchar* cache_dir =
@@ -377,3 +371,15 @@ void foreseerr_web_register(FlEngine* engine) {
   fl_method_channel_set_method_call_handler(channel, HandleMethod, nullptr,
                                             nullptr);
 }
+
+void foreseerr_web_prepare_environment() {
+  // WebKitGTK 2.54's Skia compositor flashes old frames during fades and
+  // repaints without end on CSS backdrop-filter; the previous one draws on
+  // the GPU without either.
+  g_setenv("WEBKIT_USE_SKIA_FOR_COMPOSITION", "0", FALSE);
+  // NVIDIA under Wayland: WebKit's frames trip over the driver's explicit
+  // sync (Wayland protocol error 71). Read when the window's GL starts.
+  if (g_file_test("/sys/module/nvidia", G_FILE_TEST_IS_DIR)) {
+    g_setenv("__NV_DISABLE_EXPLICIT_SYNC", "1", FALSE);
+  }
+}
diff --git a/linux/runner/foreseerr_web.h b/linux/runner/foreseerr_web.h
index 1c308f593..7a2a33637 100644
--- a/linux/runner/foreseerr_web.h
+++ b/linux/runner/foreseerr_web.h
@@ -13,4 +13,7 @@ GtkWidget* foreseerr_web_wrap(FlView* view);
 // Registers the foreseerr/web channel on the given engine.
 void foreseerr_web_register(FlEngine* engine);
 
+// Sets what the web view needs from the environment; call before GTK starts.
+void foreseerr_web_prepare_environment();
+
 #endif  // RUNNER_FORESEERR_WEB_H_
diff --git a/linux/runner/main.cc b/linux/runner/main.cc
index e7c5c5437..0d6fd1c23 100644
--- a/linux/runner/main.cc
+++ b/linux/runner/main.cc
@@ -1,6 +1,8 @@
+#include "foreseerr_web.h"
 #include "my_application.h"
 
 int main(int argc, char** argv) {
+  foreseerr_web_prepare_environment();
   g_autoptr(MyApplication) app = my_application_new();
   return g_application_run(G_APPLICATION(app), argc, argv);
 }
