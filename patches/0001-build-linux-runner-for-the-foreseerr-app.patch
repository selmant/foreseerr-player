From c7298136fd598948775f22ae212ee48b4d8d28df Mon Sep 17 00:00:00 2001
From: Selman Trabzon <selman.trbzon@gmail.com>
Date: Sat, 21 Nov 2026 16:59:24 +0300
Subject: [PATCH 1/2] build: linux runner for the foreseerr app

Builds as foreseerr-player (org.foreseerr.player) with WebKitGTK and
hands the application to foreseerr_web_install() from the overlay.
---
 linux/CMakeLists.txt        | 5 +++--
 linux/runner/CMakeLists.txt | 2 ++
 linux/runner/main.cc        | 2 ++
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/linux/CMakeLists.txt b/linux/CMakeLists.txt
index c7a3dd6c6..2f3d8fefb 100644
--- a/linux/CMakeLists.txt
+++ b/linux/CMakeLists.txt
@@ -2,8 +2,8 @@
 cmake_minimum_required(VERSION 3.13)
 project(runner LANGUAGES CXX)
 
-set(BINARY_NAME "moonfin")
-set(APPLICATION_ID "org.moonfin.linux")
+set(BINARY_NAME "foreseerr-player")
+set(APPLICATION_ID "org.foreseerr.player")
 
 # Explicitly opt in to modern CMake behaviors to avoid warnings with recent
 # versions of CMake.
@@ -49,6 +49,7 @@ add_subdirectory(${FLUTTER_MANAGED_DIR})
 # System-level dependencies.
 find_package(PkgConfig REQUIRED)
 pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-3.0)
+pkg_check_modules(WEBKIT REQUIRED IMPORTED_TARGET webkit2gtk-4.1)
 
 # Shared libretro host and its desktop audio sink, linked into the runner.
 set(LIBRETRO_HOST_AUDIO ON CACHE BOOL "" FORCE)
diff --git a/linux/runner/CMakeLists.txt b/linux/runner/CMakeLists.txt
index 9d71e1ab2..d936416fd 100644
--- a/linux/runner/CMakeLists.txt
+++ b/linux/runner/CMakeLists.txt
@@ -9,6 +9,7 @@ project(runner LANGUAGES CXX)
 add_executable(${BINARY_NAME}
   "main.cc"
   "my_application.cc"
+  "foreseerr_web.cc"
   "native_game.cc"
   "${FLUTTER_MANAGED_DIR}/generated_plugin_registrant.cc"
 )
@@ -23,6 +24,7 @@ add_definitions(-DAPPLICATION_ID="${APPLICATION_ID}")
 # Add dependency libraries. Add any application-specific dependencies here.
 target_link_libraries(${BINARY_NAME} PRIVATE flutter)
 target_link_libraries(${BINARY_NAME} PRIVATE PkgConfig::GTK)
+target_link_libraries(${BINARY_NAME} PRIVATE PkgConfig::WEBKIT)
 target_link_libraries(${BINARY_NAME} PRIVATE libretro_host lh_audio)
 
 target_include_directories(${BINARY_NAME} PRIVATE "${CMAKE_SOURCE_DIR}")
diff --git a/linux/runner/main.cc b/linux/runner/main.cc
index e7c5c5437..f92480e7b 100644
--- a/linux/runner/main.cc
+++ b/linux/runner/main.cc
@@ -1,6 +1,8 @@
+#include "foreseerr_web.h"
 #include "my_application.h"
 
 int main(int argc, char** argv) {
   g_autoptr(MyApplication) app = my_application_new();
+  foreseerr_web_install(G_APPLICATION(app));
   return g_application_run(G_APPLICATION(app), argc, argv);
 }
